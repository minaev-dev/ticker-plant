cat << 'EOF' > CMakeLists.txt
cmake_minimum_required(VERSION 3.16)
project(ticker_plant VERSION 0.1.0 LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

add_library(ticker_plant_lib
  src/version.cpp
)
target_include_directories(ticker_plant_lib
  PUBLIC
    ${CMAKE_CURRENT_SOURCE_DIR}/include
)
target_compile_options(ticker_plant_lib
  PRIVATE
    -Wall -Wextra -Wpedantic
)

add_executable(ticker_plant_app
  src/main.cpp
)
target_link_libraries(ticker_plant_app
  PRIVATE
    ticker_plant_lib
)
target_compile_options(ticker_plant_app
  PRIVATE
    -Wall -Wextra -Wpedantic
)

include(FetchContent)
FetchContent_Declare(
  googletest
  URL https://github.com/google/googletest/archive/refs/tags/v1.15.2.zip
  DOWNLOAD_EXTRACT_TIMESTAMP TRUE
)
set(gtest_force_shared_crt ON CACHE BOOL "" FORCE)
FetchContent_MakeAvailable(googletest)

enable_testing()
include(GoogleTest)

add_executable(ticker_plant_tests
  tests/test_version.cpp
)
target_link_libraries(ticker_plant_tests
  PRIVATE
    ticker_plant_lib
    GTest::gtest_main
)
target_compile_options(ticker_plant_tests
  PRIVATE
    -Wall -Wextra -Wpedantic
)

gtest_discover_tests(ticker_plant_tests)
EOF
